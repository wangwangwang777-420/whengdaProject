# Django 环境变量配置示例
# 复制此文件为 .env 并填入真实值（.env 已在 .gitignore 中忽略）

# Django Secret Key（生成方法: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"）
SECRET_KEY=your-secret-key-here

# 邮件配置
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=25
EMAIL_HOST_USER=your-email@qq.com
EMAIL_HOST_PASSWORD=your-email-authorization-code
EMAIL_USE_TLS=True
